# ============================================
# MusicGPT Backend - Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration
# ============================================
# For Docker: postgresql://musicpt_user:musicpt_password@postgres:5432/musicpt_db?schema=public
# For Local: postgresql://musicpt_user:musicpt_password@localhost:5432/musicpt_db?schema=public
DATABASE_URL=postgresql://musicpt_user:musicpt_password@localhost:5432/musicpt_db?schema=public

# ============================================
# Redis Configuration
# ============================================
# For Docker: redis
# For Local: localhost
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Change this to a strong, random secret in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# ============================================
# Rate Limiting Configuration
# ============================================
# Requests per minute for each tier
RATE_LIMIT_FREE_TIER=20
RATE_LIMIT_PAID_TIER=100
RATE_LIMIT_WINDOW_MS=300000

# ============================================
# Cache Configuration
# ============================================
# Cache TTL in seconds
CACHE_TTL=60

# ============================================
# Job Queue Configuration
# ============================================
QUEUE_NAME=prompt-processing
QUEUE_CONCURRENCY=5

# ============================================
# Cron Scheduler Configuration
# ============================================
# Cron expression for scanning pending prompts
# Default: Every 30 seconds
# Format: second minute hour day month day-of-week
CRON_SCAN_INTERVAL=*/30 * * * * *
